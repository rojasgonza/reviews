# Base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/reviews_db?schema=public"

# Servidor
PORT=4000
NODE_ENV=production
APP_URL="https://midominio.com"
FRONTEND_URL="https://midominio.com"

# Autenticación
JWT_SECRET="cambiar_por_un_secreto_largo_y_aleatorio"
JWT_EXPIRES_IN="8h"
COOKIE_NAME="reviews_admin_token"

# WhatsApp Business Cloud API (Meta)
# Ver docs/DEPLOYMENT.md sección "WhatsApp" para cómo obtenerlas
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v20.0"

# Seed inicial de admin (solo se usa una vez, al correr `npm run seed`)
SEED_ADMIN_EMAIL="admin@midominio.com"
SEED_ADMIN_PASSWORD="cambiar_esta_password"

# Rate limiting
REVIEW_RATE_LIMIT_WINDOW_HOURS=6
REVIEW_RATE_LIMIT_MAX=1

# Alertas: intervalo del cron que revisa si hay que enviar notificaciones (minutos)
ALERT_CRON_INTERVAL_MINUTES=5
